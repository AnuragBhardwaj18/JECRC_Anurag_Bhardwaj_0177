@model List<EMS.Mvc.Models.Employee>

<h2>Employee List</h2>

<a asp-action="Create" class="btn btn-primary">Add Employee</a>

<br />
<br />

<table class="table table-bordered">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Department</th>
        <th>Salary</th>
        <th>Actions</th>
    </tr>

    @foreach (var emp in Model)
    {
        <tr>
            <td>@emp.Id</td>
            <td>@emp.Name</td>
            <td>@emp.Department</td>
            <td>@emp.Salary</td>
            <td>
                <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@emp.Id" class="btn btn-danger">Delete</a>
            </td>
        </tr>
    }
</table>